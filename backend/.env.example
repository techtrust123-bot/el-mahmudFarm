# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-64-characters-long-random-string-here
JWT_REFRESH_SECRET=your-super-secure-jwt-refresh-secret-key-at-least-64-characters-long-random-string-here

# Database
MONGO_URI=mongodb://localhost:27017/cloudfarm

# Frontend
FRONTEND_URL=http://localhost:5173

# Email
SENDER_MAIL=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Environment
NODE_ENV=development

# Server
PORT=3000